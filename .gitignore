# Downloaded example weights archive (see examples/pretrained_catalog/fetch_model_weights.py)
/pretrained_model_weights.tar.gz

# Downloaded baseline weights (see reproduction/baselines/fetch_baseline_weights.py)
reproduction/baselines/weights/

# Cloned upstream baseline repos (see each adapter module's docstring for
# the exact repo/commit to clone).
reproduction/upstream/

# The MoO3 texture model is the one set of weights committed directly: it is a
# single ~1.8MB file (not the 365-model, ~640MB catalog), and it is the only
# thing standing between a fresh clone and reproducing the texture result, so
# it is not worth a separate hosted download.
!reproduction/texture_model/detection_model_MoO3_62.pth

# Output from running the reproduction/run_*.py scripts
reproduction_*_out/
*_results.json
*_predictions.json

# DARA's downsized_length option (on by default in DaraConfig) writes a
# scratch downsampled copy into the source pattern's own directory rather
# than a dedicated temp/output location.
*_downsized/

